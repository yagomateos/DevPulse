# ---------------------------------------------------------------------------
# AI Engineering Workspace — environment variables
# Everything is optional: with no variables set the app runs fully offline
# (in-memory demo data + deterministic demo AI model).
# ---------------------------------------------------------------------------

# Signs session cookies (HMAC-SHA256). REQUIRED for production builds.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Demo conveniences (choose role at sign-in, switch roles, simulate session
# expiry, per-request network switches). On by default; set to false for the
# production security posture.
DEMO_MODE=true

# Data source: "memory" (default, demo data) or "postgres".
DATA_SOURCE=memory
# Used when DATA_SOURCE=postgres (and by `npm run db:*`).
DATABASE_URL=postgres://aiw:aiw@localhost:5432/aiw

# GitHub pull-request sync (see README → GitHub integration).
# Fine-grained token, read-only "Pull requests" + "Checks". Optional for public repos (60 req/h).
GITHUB_TOKEN=
# Shared secret configured on the repository's webhook. Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Bearer token for /api/cron/github-sync (Vercel Cron sends it automatically).
CRON_SECRET=

# OpenAI-compatible LLM. Leave AI_API_KEY empty to use the demo model.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# Demo / testing switches
# MOCK_NETWORK=off       disables simulated latency & failures in the mock API
# INSECURE_COOKIES=true  allows session cookies over plain HTTP (local Docker)
